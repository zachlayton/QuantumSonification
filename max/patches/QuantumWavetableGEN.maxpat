, 			{
				"box" : 				{
					"id" : "obj-65",
					"maxclass" : "message",
					"numinlets" : 2,
					"numoutlets" : 1,
					"outlettype" : [ "" ],
					"patching_rect" : [ 793.5, 406.0, 694.0, 22.0 ],
					"text" : "b0 $1, b1 $2, b2 $3, b3 $4, b4 $5, b5 $6, b6 $7, b7 $8, b8 $9, b9 $10, b10 \\$11, b11 \\$12, b12 \\$13, b13 \\$14, b14 \\$15, b15 \\$16"
				}

			}
, 			{
				"box" : 				{
					"code" : "// QMW Density Field Wavetable 256 Direct\n//\n// Gen~ codebox.\n// Feed a frequency signal/control into in1.\n// Map OSC real scanner values into params b0..b15.\n// Optional companion lists:\n//   imag      -> im0..im15\n//   magnitude -> m0..m15\n//   phase     -> ph0..ph15\n//   speed     -> s0..s15\n// The 16 basis values are treated as cyclic knots and interpolated as a\n// 256-point virtual wavetable.\n\nParam b0(0);\nParam b1(0);\nParam b2(0);\nParam b3(0);\nParam b4(0);\nParam b5(0);\nParam b6(0);\nParam b7(0);\nParam b8(0);\nParam b9(0);\nParam b10(0);\nParam b11(0);\nParam b12(0);\nParam b13(0);\nParam b14(0);\nParam b15(0);\n\nParam im0(0);\nParam im1(0);\nParam im2(0);\nParam im3(0);\nParam im4(0);\nParam im5(0);\nParam im6(0);\nParam im7(0);\nParam im8(0);\nParam im9(0);\nParam im10(0);\nParam im11(0);\nParam im12(0);\nParam im13(0);\nParam im14(0);\nParam im15(0);\n\nParam m0(1);\nParam m1(1);\nParam m2(1);\nParam m3(1);\nParam m4(1);\nParam m5(1);\nParam m6(1);\nParam m7(1);\nParam m8(1);\nParam m9(1);\nParam m10(1);\nParam m11(1);\nParam m12(1);\nParam m13(1);\nParam m14(1);\nParam m15(1);\n\nParam ph0(0);\nParam ph1(0);\nParam ph2(0);\nParam ph3(0);\nParam ph4(0);\nParam ph5(0);\nParam ph6(0);\nParam ph7(0);\nParam ph8(0);\nParam ph9(0);\nParam ph10(0);\nParam ph11(0);\nParam ph12(0);\nParam ph13(0);\nParam ph14(0);\nParam ph15(0);\n\nParam s0(0);\nParam s1(0);\nParam s2(0);\nParam s3(0);\nParam s4(0);\nParam s5(0);\nParam s6(0);\nParam s7(0);\nParam s8(0);\nParam s9(0);\nParam s10(0);\nParam s11(0);\nParam s12(0);\nParam s13(0);\nParam s14(0);\nParam s15(0);\n\nParam purity(1);\nParam entropy(0);\nParam coherence(0);\nParam amp(0.2);\nParam mix_voices(4);\nParam output_ceiling(0.85);\nParam default_freq(55);\nParam value_smooth_ms(40);\nParam magnitude_smooth_ms(100);\nParam phase_smooth_ms(80);\nParam fast_smooth_ms(10);\nParam slow_smooth_ms(150);\nParam phase_depth(0.025);\nParam imag_mix(0.35);\nParam drive(1.2);\nParam max_drive(4);\nParam auto_level(0.5);\n\nHistory phase(0);\nHistory sb0(0);\nHistory sb1(0);\nHistory sb2(0);\nHistory sb3(0);\nHistory sb4(0);\nHistory sb5(0);\nHistory sb6(0);\nHistory sb7(0);\nHistory sb8(0);\nHistory sb9(0);\nHistory sb10(0);\nHistory sb11(0);\nHistory sb12(0);\nHistory sb13(0);\nHistory sb14(0);\nHistory sb15(0);\nHistory sim0(0);\nHistory sim1(0);\nHistory sim2(0);\nHistory sim3(0);\nHistory sim4(0);\nHistory sim5(0);\nHistory sim6(0);\nHistory sim7(0);\nHistory sim8(0);\nHistory sim9(0);\nHistory sim10(0);\nHistory sim11(0);\nHistory sim12(0);\nHistory sim13(0);\nHistory sim14(0);\nHistory sim15(0);\nHistory sm0(1);\nHistory sm1(1);\nHistory sm2(1);\nHistory sm3(1);\nHistory sm4(1);\nHistory sm5(1);\nHistory sm6(1);\nHistory sm7(1);\nHistory sm8(1);\nHistory sm9(1);\nHistory sm10(1);\nHistory sm11(1);\nHistory sm12(1);\nHistory sm13(1);\nHistory sm14(1);\nHistory sm15(1);\nHistory sph0(0);\nHistory sph1(0);\nHistory sph2(0);\nHistory sph3(0);\nHistory sph4(0);\nHistory sph5(0);\nHistory sph6(0);\nHistory sph7(0);\nHistory sph8(0);\nHistory sph9(0);\nHistory sph10(0);\nHistory sph11(0);\nHistory sph12(0);\nHistory sph13(0);\nHistory sph14(0);\nHistory sph15(0);\n\nfreq = (in1 > 0) * in1 + (in1 <= 0) * default_freq;\nphase = fract(phase + freq / samplerate);\n\nfast_ms = max(fast_smooth_ms, 0.1);\nslow_ms = max(slow_smooth_ms, fast_ms);\nbase_ms = max(value_smooth_ms, 0.1);\n\nms0 = mix(slow_ms, fast_ms, clamp(abs(s0), 0, 1));\nms1 = mix(slow_ms, fast_ms, clamp(abs(s1), 0, 1));\nms2 = mix(slow_ms, fast_ms, clamp(abs(s2), 0, 1));\nms3 = mix(slow_ms, fast_ms, clamp(abs(s3), 0, 1));\nms4 = mix(slow_ms, fast_ms, clamp(abs(s4), 0, 1));\nms5 = mix(slow_ms, fast_ms, clamp(abs(s5), 0, 1));\nms6 = mix(slow_ms, fast_ms, clamp(abs(s6), 0, 1));\nms7 = mix(slow_ms, fast_ms, clamp(abs(s7), 0, 1));\nms8 = mix(slow_ms, fast_ms, clamp(abs(s8), 0, 1));\nms9 = mix(slow_ms, fast_ms, clamp(abs(s9), 0, 1));\nms10 = mix(slow_ms, fast_ms, clamp(abs(s10), 0, 1));\nms11 = mix(slow_ms, fast_ms, clamp(abs(s11), 0, 1));\nms12 = mix(slow_ms, fast_ms, clamp(abs(s12), 0, 1));\nms13 = mix(slow_ms, fast_ms, clamp(abs(s13), 0, 1));\nms14 = mix(slow_ms, fast_ms, clamp(abs(s14), 0, 1));\nms15 = mix(slow_ms, fast_ms, clamp(abs(s15), 0, 1));\n\n// Let the global fallback smoothing still matter if speed is not patched.\nms0 = mix(base_ms, ms0, clamp(abs(s0), 0, 1));\nms1 = mix(base_ms, ms1, clamp(abs(s1), 0, 1));\nms2 = mix(base_ms, ms2, clamp(abs(s2), 0, 1));\nms3 = mix(base_ms, ms3, clamp(abs(s3), 0, 1));\nms4 = mix(base_ms, ms4, clamp(abs(s4), 0, 1));\nms5 = mix(base_ms, ms5, clamp(abs(s5), 0, 1));\nms6 = mix(base_ms, ms6, clamp(abs(s6), 0, 1));\nms7 = mix(base_ms, ms7, clamp(abs(s7), 0, 1));\nms8 = mix(base_ms, ms8, clamp(abs(s8), 0, 1));\nms9 = mix(base_ms, ms9, clamp(abs(s9), 0, 1));\nms10 = mix(base_ms, ms10, clamp(abs(s10), 0, 1));\nms11 = mix(base_ms, ms11, clamp(abs(s11), 0, 1));\nms12 = mix(base_ms, ms12, clamp(abs(s12), 0, 1));\nms13 = mix(base_ms, ms13, clamp(abs(s13), 0, 1));\nms14 = mix(base_ms, ms14, clamp(abs(s14), 0, 1));\nms15 = mix(base_ms, ms15, clamp(abs(s15), 0, 1));\n\nc0 = exp(-1 / (ms0 * 0.001 * samplerate));\nc1 = exp(-1 / (ms1 * 0.001 * samplerate));\nc2 = exp(-1 / (ms2 * 0.001 * samplerate));\nc3 = exp(-1 / (ms3 * 0.001 * samplerate));\nc4 = exp(-1 / (ms4 * 0.001 * samplerate));\nc5 = exp(-1 / (ms5 * 0.001 * samplerate));\nc6 = exp(-1 / (ms6 * 0.001 * samplerate));\nc7 = exp(-1 / (ms7 * 0.001 * samplerate));\nc8 = exp(-1 / (ms8 * 0.001 * samplerate));\nc9 = exp(-1 / (ms9 * 0.001 * samplerate));\nc10 = exp(-1 / (ms10 * 0.001 * samplerate));\nc11 = exp(-1 / (ms11 * 0.001 * samplerate));\nc12 = exp(-1 / (ms12 * 0.001 * samplerate));\nc13 = exp(-1 / (ms13 * 0.001 * samplerate));\nc14 = exp(-1 / (ms14 * 0.001 * samplerate));\nc15 = exp(-1 / (ms15 * 0.001 * samplerate));\n\nsb0 = b0 + c0 * (sb0 - b0);\nsb1 = b1 + c1 * (sb1 - b1);\nsb2 = b2 + c2 * (sb2 - b2);\nsb3 = b3 + c3 * (sb3 - b3);\nsb4 = b4 + c4 * (sb4 - b4);\nsb5 = b5 + c5 * (sb5 - b5);\nsb6 = b6 + c6 * (sb6 - b6);\nsb7 = b7 + c7 * (sb7 - b7);\nsb8 = b8 + c8 * (sb8 - b8);\nsb9 = b9 + c9 * (sb9 - b9);\nsb10 = b10 + c10 * (sb10 - b10);\nsb11 = b11 + c11 * (sb11 - b11);\nsb12 = b12 + c12 * (sb12 - b12);\nsb13 = b13 + c13 * (sb13 - b13);\nsb14 = b14 + c14 * (sb14 - b14);\nsb15 = b15 + c15 * (sb15 - b15);\n\nsim0 = im0 + c0 * (sim0 - im0);\nsim1 = im1 + c1 * (sim1 - im1);\nsim2 = im2 + c2 * (sim2 - im2);\nsim3 = im3 + c3 * (sim3 - im3);\nsim4 = im4 + c4 * (sim4 - im4);\nsim5 = im5 + c5 * (sim5 - im5);\nsim6 = im6 + c6 * (sim6 - im6);\nsim7 = im7 + c7 * (sim7 - im7);\nsim8 = im8 + c8 * (sim8 - im8);\nsim9 = im9 + c9 * (sim9 - im9);\nsim10 = im10 + c10 * (sim10 - im10);\nsim11 = im11 + c11 * (sim11 - im11);\nsim12 = im12 + c12 * (sim12 - im12);\nsim13 = im13 + c13 * (sim13 - im13);\nsim14 = im14 + c14 * (sim14 - im14);\nsim15 = im15 + c15 * (sim15 - im15);\n\nmag_ms = max(magnitude_smooth_ms, 0.1);\nmag_coeff = exp(-1 / (mag_ms * 0.001 * samplerate));\n\ntm0 = clamp(m0, 0, 1);\ntm1 = clamp(m1, 0, 1);\ntm2 = clamp(m2, 0, 1);\ntm3 = clamp(m3, 0, 1);\ntm4 = clamp(m4, 0, 1);\ntm5 = clamp(m5, 0, 1);\ntm6 = clamp(m6, 0, 1);\ntm7 = clamp(m7, 0, 1);\ntm8 = clamp(m8, 0, 1);\ntm9 = clamp(m9, 0, 1);\ntm10 = clamp(m10, 0, 1);\ntm11 = clamp(m11, 0, 1);\ntm12 = clamp(m12, 0, 1);\ntm13 = clamp(m13, 0, 1);\ntm14 = clamp(m14, 0, 1);\ntm15 = clamp(m15, 0, 1);\n\nsm0 = tm0 + mag_coeff * (sm0 - tm0);\nsm1 = tm1 + mag_coeff * (sm1 - tm1);\nsm2 = tm2 + mag_coeff * (sm2 - tm2);\nsm3 = tm3 + mag_coeff * (sm3 - tm3);\nsm4 = tm4 + mag_coeff * (sm4 - tm4);\nsm5 = tm5 + mag_coeff * (sm5 - tm5);\nsm6 = tm6 + mag_coeff * (sm6 - tm6);\nsm7 = tm7 + mag_coeff * (sm7 - tm7);\nsm8 = tm8 + mag_coeff * (sm8 - tm8);\nsm9 = tm9 + mag_coeff * (sm9 - tm9);\nsm10 = tm10 + mag_coeff * (sm10 - tm10);\nsm11 = tm11 + mag_coeff * (sm11 - tm11);\nsm12 = tm12 + mag_coeff * (sm12 - tm12);\nsm13 = tm13 + mag_coeff * (sm13 - tm13);\nsm14 = tm14 + mag_coeff * (sm14 - tm14);\nsm15 = tm15 + mag_coeff * (sm15 - tm15);\n\nw0 = mix(0.25, 1, sm0);\nw1 = mix(0.25, 1, sm1);\nw2 = mix(0.25, 1, sm2);\nw3 = mix(0.25, 1, sm3);\nw4 = mix(0.25, 1, sm4);\nw5 = mix(0.25, 1, sm5);\nw6 = mix(0.25, 1, sm6);\nw7 = mix(0.25, 1, sm7);\nw8 = mix(0.25, 1, sm8);\nw9 = mix(0.25, 1, sm9);\nw10 = mix(0.25, 1, sm10);\nw11 = mix(0.25, 1, sm11);\nw12 = mix(0.25, 1, sm12);\nw13 = mix(0.25, 1, sm13);\nw14 = mix(0.25, 1, sm14);\nw15 = mix(0.25, 1, sm15);\n\nphase_ms = max(phase_smooth_ms, 0.1);\nphase_coeff = exp(-1 / (phase_ms * 0.001 * samplerate));\n\n// Phase arrives wrapped near -pi..pi. Smooth the shortest wrapped difference\n// so updates do not jump across the branch cut.\ndph0 = atan2(sin(ph0 - sph0), cos(ph0 - sph0));\ndph1 = atan2(sin(ph1 - sph1), cos(ph1 - sph1));\ndph2 = atan2(sin(ph2 - sph2), cos(ph2 - sph2));\ndph3 = atan2(sin(ph3 - sph3), cos(ph3 - sph3));\ndph4 = atan2(sin(ph4 - sph4), cos(ph4 - sph4));\ndph5 = atan2(sin(ph5 - sph5), cos(ph5 - sph5));\ndph6 = atan2(sin(ph6 - sph6), cos(ph6 - sph6));\ndph7 = atan2(sin(ph7 - sph7), cos(ph7 - sph7));\ndph8 = atan2(sin(ph8 - sph8), cos(ph8 - sph8));\ndph9 = atan2(sin(ph9 - sph9), cos(ph9 - sph9));\ndph10 = atan2(sin(ph10 - sph10), cos(ph10 - sph10));\ndph11 = atan2(sin(ph11 - sph11), cos(ph11 - sph11));\ndph12 = atan2(sin(ph12 - sph12), cos(ph12 - sph12));\ndph13 = atan2(sin(ph13 - sph13), cos(ph13 - sph13));\ndph14 = atan2(sin(ph14 - sph14), cos(ph14 - sph14));\ndph15 = atan2(sin(ph15 - sph15), cos(ph15 - sph15));\n\nsph0 = sph0 + (1 - phase_coeff) * dph0;\nsph1 = sph1 + (1 - phase_coeff) * dph1;\nsph2 = sph2 + (1 - phase_coeff) * dph2;\nsph3 = sph3 + (1 - phase_coeff) * dph3;\nsph4 = sph4 + (1 - phase_coeff) * dph4;\nsph5 = sph5 + (1 - phase_coeff) * dph5;\nsph6 = sph6 + (1 - phase_coeff) * dph6;\nsph7 = sph7 + (1 - phase_coeff) * dph7;\nsph8 = sph8 + (1 - phase_coeff) * dph8;\nsph9 = sph9 + (1 - phase_coeff) * dph9;\nsph10 = sph10 + (1 - phase_coeff) * dph10;\nsph11 = sph11 + (1 - phase_coeff) * dph11;\nsph12 = sph12 + (1 - phase_coeff) * dph12;\nsph13 = sph13 + (1 - phase_coeff) * dph13;\nsph14 = sph14 + (1 - phase_coeff) * dph14;\nsph15 = sph15 + (1 - phase_coeff) * dph15;\n\n// Real is the primary contour. Imag is a quadrature color. Phase rotates that\n// local complex pair. Magnitude decides how strongly each basis knot speaks.\nk0v = w0 * (sb0 * cos(sph0) - imag_mix * sim0 * sin(sph0));\nk1v = w1 * (sb1 * cos(sph1) - imag_mix * sim1 * sin(sph1));\nk2v = w2 * (sb2 * cos(sph2) - imag_mix * sim2 * sin(sph2));\nk3v = w3 * (sb3 * cos(sph3) - imag_mix * sim3 * sin(sph3));\nk4v = w4 * (sb4 * cos(sph4) - imag_mix * sim4 * sin(sph4));\nk5v = w5 * (sb5 * cos(sph5) - imag_mix * sim5 * sin(sph5));\nk6v = w6 * (sb6 * cos(sph6) - imag_mix * sim6 * sin(sph6));\nk7v = w7 * (sb7 * cos(sph7) - imag_mix * sim7 * sin(sph7));\nk8v = w8 * (sb8 * cos(sph8) - imag_mix * sim8 * sin(sph8));\nk9v = w9 * (sb9 * cos(sph9) - imag_mix * sim9 * sin(sph9));\nk10v = w10 * (sb10 * cos(sph10) - imag_mix * sim10 * sin(sph10));\nk11v = w11 * (sb11 * cos(sph11) - imag_mix * sim11 * sin(sph11));\nk12v = w12 * (sb12 * cos(sph12) - imag_mix * sim12 * sin(sph12));\nk13v = w13 * (sb13 * cos(sph13) - imag_mix * sim13 * sin(sph13));\nk14v = w14 * (sb14 * cos(sph14) - imag_mix * sim14 * sin(sph14));\nk15v = w15 * (sb15 * cos(sph15) - imag_mix * sim15 * sin(sph15));\n\ncoh = clamp(coherence, 0, 1);\nent = clamp(entropy, 0, 1);\npur = clamp(purity, 0, 1);\nphase_offset = phase_depth * coh * (\n    sin(sph0) + sin(sph1) + sin(sph2) + sin(sph3) +\n    sin(sph4) + sin(sph5) + sin(sph6) + sin(sph7) +\n    sin(sph8) + sin(sph9) + sin(sph10) + sin(sph11) +\n    sin(sph12) + sin(sph13) + sin(sph14) + sin(sph15)\n) / 16;\n\nread_phase = fract(phase + phase_offset);\nknot_pos = read_phase * 16;\nk0 = floor(knot_pos);\nt = knot_pos - k0;\n\n// Cubic smoothstep interpolation. This keeps the 16-knot table from sounding\n// too stair-stepped while preserving the basis-state contour.\nt = t * t * (3 - 2 * t);\n\ni0 = k0;\ni1 = i0 + 1;\ni1 = i1 - (i1 >= 16) * 16;\n\nv0 =\n    (i0 == 0) * k0v +\n    (i0 == 1) * k1v +\n    (i0 == 2) * k2v +\n    (i0 == 3) * k3v +\n    (i0 == 4) * k4v +\n    (i0 == 5) * k5v +\n    (i0 == 6) * k6v +\n    (i0 == 7) * k7v +\n    (i0 == 8) * k8v +\n    (i0 == 9) * k9v +\n    (i0 == 10) * k10v +\n    (i0 == 11) * k11v +\n    (i0 == 12) * k12v +\n    (i0 == 13) * k13v +\n    (i0 == 14) * k14v +\n    (i0 == 15) * k15v;\n\nv1 =\n    (i1 == 0) * k0v +\n    (i1 == 1) * k1v +\n    (i1 == 2) * k2v +\n    (i1 == 3) * k3v +\n    (i1 == 4) * k4v +\n    (i1 == 5) * k5v +\n    (i1 == 6) * k6v +\n    (i1 == 7) * k7v +\n    (i1 == 8) * k8v +\n    (i1 == 9) * k9v +\n    (i1 == 10) * k10v +\n    (i1 == 11) * k11v +\n    (i1 == 12) * k12v +\n    (i1 == 13) * k13v +\n    (i1 == 14) * k14v +\n    (i1 == 15) * k15v;\n\nraw = mix(v0, v1, t);\n\nmean = (\n    k0v + k1v + k2v + k3v +\n    k4v + k5v + k6v + k7v +\n    k8v + k9v + k10v + k11v +\n    k12v + k13v + k14v + k15v\n) / 16;\n\ncentered = raw - mean;\npeak01 = max(abs(k0v), abs(k1v));\npeak23 = max(abs(k2v), abs(k3v));\npeak45 = max(abs(k4v), abs(k5v));\npeak67 = max(abs(k6v), abs(k7v));\npeak89 = max(abs(k8v), abs(k9v));\npeak1011 = max(abs(k10v), abs(k11v));\npeak1213 = max(abs(k12v), abs(k13v));\npeak1415 = max(abs(k14v), abs(k15v));\npeak03 = max(peak01, peak23);\npeak47 = max(peak45, peak67);\npeak811 = max(peak89, peak1011);\npeak1215 = max(peak1213, peak1415);\npeak07 = max(peak03, peak47);\npeak815 = max(peak811, peak1215);\nknot_peak = max(max(peak07, peak815), 0.25);\nlevel_scale = mix(1, 1 / knot_peak, clamp(auto_level, 0, 1));\ncentered = centered * level_scale;\n\nshaped_drive = drive * (1 + ent * 2) * mix(1.4, 0.75, pur);\nshaped_drive = min(shaped_drive, max(max_drive, 0.1));\nsig = tanh(centered * shaped_drive);\n\nvoice_scale = 1 / sqrt(max(mix_voices, 1));\nout1 = sig * amp * output_ceiling * voice_scale;\nout2 = phase;\nout3 = read_phase * 256;\n",
