adj18 = mix(adjA18, adjB18, morph);
adj19 = mix(adjA19, adjB19, morph);
adj20 = mix(adjA20, adjB20, morph);

// Active-node Householder diffusion remains energy preserving.
hh_dot = (amp1 * f1) + (amp2 * f2) + (amp3 * f3) + (amp4 * f4) + (amp5 * f5) + (amp6 * f6) + (amp7 * f7) + (amp8 * f8) + (amp9 * f9) + (amp10 * f10) + (amp11 * f11) + (amp12 * f12) + (amp13 * f13) + (amp14 * f14) + (amp15 * f15) + (amp16 * f16) + (amp17 * f17) + (amp18 * f18) + (amp19 * f19) + (amp20 * f20);
hh_den = active_sum;
hh1 = f1 - 2 * amp1 * hh_dot / hh_den;
hh2 = f2 - 2 * amp2 * hh_dot / hh_den;
hh3 = f3 - 2 * amp3 * hh_dot / hh_den;
hh4 = f4 - 2 * amp4 * hh_dot / hh_den;
hh5 = f5 - 2 * amp5 * hh_dot / hh_den;
hh6 = f6 - 2 * amp6 * hh_dot / hh_den;
hh7 = f7 - 2 * amp7 * hh_dot / hh_den;
hh8 = f8 - 2 * amp8 * hh_dot / hh_den;
hh9 = f9 - 2 * amp9 * hh_dot / hh_den;
hh10 = f10 - 2 * amp10 * hh_dot / hh_den;
hh11 = f11 - 2 * amp11 * hh_dot / hh_den;
hh12 = f12 - 2 * amp12 * hh_dot / hh_den;
hh13 = f13 - 2 * amp13 * hh_dot / hh_den;
hh14 = f14 - 2 * amp14 * hh_dot / hh_den;
hh15 = f15 - 2 * amp15 * hh_dot / hh_den;
hh16 = f16 - 2 * amp16 * hh_dot / hh_den;
hh17 = f17 - 2 * amp17 * hh_dot / hh_den;
hh18 = f18 - 2 * amp18 * hh_dot / hh_den;
hh19 = f19 - 2 * amp19 * hh_dot / hh_den;
hh20 = f20 - 2 * amp20 * hh_dot / hh_den;

topo = clamp(topology, 0, 1);
net1 = mix(hh1, adj1, topo);
net2 = mix(hh2, adj2, topo);
net3 = mix(hh3, adj3, topo);
net4 = mix(hh4, adj4, topo);
net5 = mix(hh5, adj5, topo);
net6 = mix(hh6, adj6, topo);
net7 = mix(hh7, adj7, topo);
net8 = mix(hh8, adj8, topo);
net9 = mix(hh9, adj9, topo);
net10 = mix(hh10, adj10, topo);
net11 = mix(hh11, adj11, topo);
net12 = mix(hh12, adj12, topo);
net13 = mix(hh13, adj13, topo);
net14 = mix(hh14, adj14, topo);
net15 = mix(hh15, adj15, topo);
net16 = mix(hh16, adj16, topo);
net17 = mix(hh17, adj17, topo);
net18 = mix(hh18, adj18, topo);
net19 = mix(hh19, adj19, topo);
net20 = mix(hh20, adj20, topo);

// Delay-compensated T60 feedback.
dec = clamp(decay, 0, 1);
t60 = 0.18 * pow(194.444444, dec);
g1 = pow(10, (-3 * d1) / (sr * t60));
g2 = pow(10, (-3 * d2) / (sr * t60));
g3 = pow(10, (-3 * d3) / (sr * t60));
g4 = pow(10, (-3 * d4) / (sr * t60));
g5 = pow(10, (-3 * d5) / (sr * t60));
g6 = pow(10, (-3 * d6) / (sr * t60));
g7 = pow(10, (-3 * d7) / (sr * t60));
g8 = pow(10, (-3 * d8) / (sr * t60));
g9 = pow(10, (-3 * d9) / (sr * t60));
g10 = pow(10, (-3 * d10) / (sr * t60));
g11 = pow(10, (-3 * d11) / (sr * t60));
g12 = pow(10, (-3 * d12) / (sr * t60));
g13 = pow(10, (-3 * d13) / (sr * t60));
g14 = pow(10, (-3 * d14) / (sr * t60));
g15 = pow(10, (-3 * d15) / (sr * t60));
g16 = pow(10, (-3 * d16) / (sr * t60));
g17 = pow(10, (-3 * d17) / (sr * t60));
g18 = pow(10, (-3 * d18) / (sr * t60));
g19 = pow(10, (-3 * d19) / (sr * t60));
g20 = pow(10, (-3 * d20) / (sr * t60));

fr = clamp(freeze, 0, 1);
inj1 = diffused * 1 * amp1 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr1));
fb1 = net1 * mix(g1, 0.9995, fr);
w1 = (inj1 * (1 - fr) + fb1) * amp1;
dl1.write(tanh(w1));
inj2 = diffused * -1 * amp2 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr2));
fb2 = net2 * mix(g2, 0.9995, fr);
w2 = (inj2 * (1 - fr) + fb2) * amp2;
dl2.write(tanh(w2));
inj3 = diffused * -1 * amp3 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr3));
fb3 = net3 * mix(g3, 0.9995, fr);
w3 = (inj3 * (1 - fr) + fb3) * amp3;
dl3.write(tanh(w3));
inj4 = diffused * 1 * amp4 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr4));
fb4 = net4 * mix(g4, 0.9995, fr);
w4 = (inj4 * (1 - fr) + fb4) * amp4;
dl4.write(tanh(w4));
inj5 = diffused * -1 * amp5 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr5));
fb5 = net5 * mix(g5, 0.9995, fr);
w5 = (inj5 * (1 - fr) + fb5) * amp5;
dl5.write(tanh(w5));
inj6 = diffused * 1 * amp6 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr6));
fb6 = net6 * mix(g6, 0.9995, fr);
w6 = (inj6 * (1 - fr) + fb6) * amp6;
dl6.write(tanh(w6));
inj7 = diffused * 1 * amp7 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr7));
fb7 = net7 * mix(g7, 0.9995, fr);
w7 = (inj7 * (1 - fr) + fb7) * amp7;
dl7.write(tanh(w7));
inj8 = diffused * -1 * amp8 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr8));
fb8 = net8 * mix(g8, 0.9995, fr);
w8 = (inj8 * (1 - fr) + fb8) * amp8;
dl8.write(tanh(w8));
inj9 = diffused * -1 * amp9 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr9));
fb9 = net9 * mix(g9, 0.9995, fr);
w9 = (inj9 * (1 - fr) + fb9) * amp9;
dl9.write(tanh(w9));
inj10 = diffused * 1 * amp10 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr10));
fb10 = net10 * mix(g10, 0.9995, fr);
w10 = (inj10 * (1 - fr) + fb10) * amp10;
dl10.write(tanh(w10));
inj11 = diffused * 1 * amp11 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr11));
fb11 = net11 * mix(g11, 0.9995, fr);
w11 = (inj11 * (1 - fr) + fb11) * amp11;
dl11.write(tanh(w11));
inj12 = diffused * -1 * amp12 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr12));
fb12 = net12 * mix(g12, 0.9995, fr);
w12 = (inj12 * (1 - fr) + fb12) * amp12;
dl12.write(tanh(w12));
inj13 = diffused * 1 * amp13 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr13));
fb13 = net13 * mix(g13, 0.9995, fr);
w13 = (inj13 * (1 - fr) + fb13) * amp13;
dl13.write(tanh(w13));
inj14 = diffused * -1 * amp14 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr14));
fb14 = net14 * mix(g14, 0.9995, fr);
w14 = (inj14 * (1 - fr) + fb14) * amp14;
dl14.write(tanh(w14));
inj15 = diffused * -1 * amp15 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr15));
fb15 = net15 * mix(g15, 0.9995, fr);
w15 = (inj15 * (1 - fr) + fb15) * amp15;
dl15.write(tanh(w15));
inj16 = diffused * 1 * amp16 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr16));
fb16 = net16 * mix(g16, 0.9995, fr);
w16 = (inj16 * (1 - fr) + fb16) * amp16;
dl16.write(tanh(w16));
inj17 = diffused * -1 * amp17 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr17));
fb17 = net17 * mix(g17, 0.9995, fr);
w17 = (inj17 * (1 - fr) + fb17) * amp17;
dl17.write(tanh(w17));
inj18 = diffused * 1 * amp18 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr18));
fb18 = net18 * mix(g18, 0.9995, fr);
w18 = (inj18 * (1 - fr) + fb18) * amp18;
dl18.write(tanh(w18));
inj19 = diffused * 1 * amp19 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr19));
fb19 = net19 * mix(g19, 0.9995, fr);
w19 = (inj19 * (1 - fr) + fb19) * amp19;
dl19.write(tanh(w19));
inj20 = diffused * -1 * amp20 * input_norm * (0.65 + 0.35 * (0.5 + 0.5 * zr20));
fb20 = net20 * mix(g20, 0.9995, fr);
w20 = (inj20 * (1 - fr) + fb20) * amp20;
dl20.write(tanh(w20));

// Spatial decoder follows the continuously rotated/morphed coordinates.
wd = clamp(width, 0, 1);
out_norm = output_gain / sqrt(active_sum);
left =
    (r1 * amp1 * sqrt(0.5 * (1 - clamp(xr1 * wd, -1, 1)))) +
    (r2 * amp2 * sqrt(0.5 * (1 - clamp(xr2 * wd, -1, 1)))) +
    (r3 * amp3 * sqrt(0.5 * (1 - clamp(xr3 * wd, -1, 1)))) +
    (r4 * amp4 * sqrt(0.5 * (1 - clamp(xr4 * wd, -1, 1)))) +
    (r5 * amp5 * sqrt(0.5 * (1 - clamp(xr5 * wd, -1, 1)))) +
    (r6 * amp6 * sqrt(0.5 * (1 - clamp(xr6 * wd, -1, 1)))) +
    (r7 * amp7 * sqrt(0.5 * (1 - clamp(xr7 * wd, -1, 1)))) +
    (r8 * amp8 * sqrt(0.5 * (1 - clamp(xr8 * wd, -1, 1)))) +
    (r9 * amp9 * sqrt(0.5 * (1 - clamp(xr9 * wd, -1, 1)))) +
    (r10 * amp10 * sqrt(0.5 * (1 - clamp(xr10 * wd, -1, 1)))) +
    (r11 * amp11 * sqrt(0.5 * (1 - clamp(xr11 * wd, -1, 1)))) +
    (r12 * amp12 * sqrt(0.5 * (1 - clamp(xr12 * wd, -1, 1)))) +
    (r13 * amp13 * sqrt(0.5 * (1 - clamp(xr13 * wd, -1, 1)))) +
    (r14 * amp14 * sqrt(0.5 * (1 - clamp(xr14 * wd, -1, 1)))) +
    (r15 * amp15 * sqrt(0.5 * (1 - clamp(xr15 * wd, -1, 1)))) +
    (r16 * amp16 * sqrt(0.5 * (1 - clamp(xr16 * wd, -1, 1)))) +
    (r17 * amp17 * sqrt(0.5 * (1 - clamp(xr17 * wd, -1, 1)))) +
    (r18 * amp18 * sqrt(0.5 * (1 - clamp(xr18 * wd, -1, 1)))) +
    (r19 * amp19 * sqrt(0.5 * (1 - clamp(xr19 * wd, -1, 1)))) +
    (r20 * amp20 * sqrt(0.5 * (1 - clamp(xr20 * wd, -1, 1))));
right =
    (r1 * amp1 * sqrt(0.5 * (1 + clamp(xr1 * wd, -1, 1)))) +
    (r2 * amp2 * sqrt(0.5 * (1 + clamp(xr2 * wd, -1, 1)))) +
    (r3 * amp3 * sqrt(0.5 * (1 + clamp(xr3 * wd, -1, 1)))) +
    (r4 * amp4 * sqrt(0.5 * (1 + clamp(xr4 * wd, -1, 1)))) +
    (r5 * amp5 * sqrt(0.5 * (1 + clamp(xr5 * wd, -1, 1)))) +
    (r6 * amp6 * sqrt(0.5 * (1 + clamp(xr6 * wd, -1, 1)))) +
    (r7 * amp7 * sqrt(0.5 * (1 + clamp(xr7 * wd, -1, 1)))) +
    (r8 * amp8 * sqrt(0.5 * (1 + clamp(xr8 * wd, -1, 1)))) +
    (r9 * amp9 * sqrt(0.5 * (1 + clamp(xr9 * wd, -1, 1)))) +
    (r10 * amp10 * sqrt(0.5 * (1 + clamp(xr10 * wd, -1, 1)))) +
    (r11 * amp11 * sqrt(0.5 * (1 + clamp(xr11 * wd, -1, 1)))) +
    (r12 * amp12 * sqrt(0.5 * (1 + clamp(xr12 * wd, -1, 1)))) +
    (r13 * amp13 * sqrt(0.5 * (1 + clamp(xr13 * wd, -1, 1)))) +
    (r14 * amp14 * sqrt(0.5 * (1 + clamp(xr14 * wd, -1, 1)))) +
    (r15 * amp15 * sqrt(0.5 * (1 + clamp(xr15 * wd, -1, 1)))) +
    (r16 * amp16 * sqrt(0.5 * (1 + clamp(xr16 * wd, -1, 1)))) +
    (r17 * amp17 * sqrt(0.5 * (1 + clamp(xr17 * wd, -1, 1)))) +
    (r18 * amp18 * sqrt(0.5 * (1 + clamp(xr18 * wd, -1, 1)))) +
    (r19 * amp19 * sqrt(0.5 * (1 + clamp(xr19 * wd, -1, 1)))) +
    (r20 * amp20 * sqrt(0.5 * (1 + clamp(xr20 * wd, -1, 1))));
out1 = left * out_norm;
out2 = right * out_norm;
