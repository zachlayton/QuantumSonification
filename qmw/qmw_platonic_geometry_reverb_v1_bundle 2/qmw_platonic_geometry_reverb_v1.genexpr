// qmw_platonic_geometry_reverb_v1.genexpr
// Twenty-node morphing Platonic feedback-delay network for Max Gen~.
//
// in1      mono audio input
// in2..in9 eight Pauli-correlation signals in the range -1..1
// out1     left reverberant output
// out2     right reverberant output
//
// solid IDs:
// 0 tetrahedron  {3,3}
// 1 cube         {4,3}
// 2 octahedron   {3,4}
// 3 dodecahedron {5,3}
// 4 icosahedron  {3,5}
//
// The engine keeps twenty DSP nodes and morphs four linked fields:
// activation, spherical coordinates, overtone-derived delay ratios,
// and normalized graph adjacency. This allows continuous topology changes.

Param solid_a(1);
Param solid_b(2);
Param geometry_morph(0);
Param morph_slew_ms(500);
Param size(0.45);
Param decay(0.72);
Param diffusion(0.72);
Param absorb(0.35);
Param tilt(0);
Param topology(0.80);
Param geometry_depth(0.55);
Param harmonicity(0.25);
Param harmonic_span(0.22);
Param pauli_depth(0.16);
Param rot_x(0);
Param rot_y(0);
Param rot_z(0);
Param width(0.90);
Param freeze(0);
Param input_gain(0.25);
Param output_gain(0.40);

Delay dl1(384000);
Delay dl2(384000);
Delay dl3(384000);
Delay dl4(384000);
Delay dl5(384000);
Delay dl6(384000);
Delay dl7(384000);
Delay dl8(384000);
Delay dl9(384000);
Delay dl10(384000);
Delay dl11(384000);
Delay dl12(384000);
Delay dl13(384000);
Delay dl14(384000);
Delay dl15(384000);
Delay dl16(384000);
Delay dl17(384000);
Delay dl18(384000);
Delay dl19(384000);
Delay dl20(384000);

History lp1(0);
History lp2(0);
History lp3(0);
History lp4(0);
History lp5(0);
History lp6(0);
History lp7(0);
History lp8(0);
History lp9(0);
History lp10(0);
History lp11(0);
History lp12(0);
History lp13(0);
History lp14(0);
History lp15(0);
History lp16(0);
History lp17(0);
History lp18(0);
History lp19(0);
History lp20(0);

History apz1(0);
History apz2(0);
History apz3(0);
History apz4(0);
History morph_z(0);

sr = samplerate;
pi2 = 6.28318530718;

// Input diffusion.
diff_g = 0.15 + 0.70 * clamp(diffusion, 0, 1);
x = in1 * input_gain;
a1d = x - diff_g * apz1;
y1d = apz1 + diff_g * a1d;
apz1 = a1d;
a2d = y1d - diff_g * apz2;
y2d = apz2 + diff_g * a2d;
apz2 = a2d;
a3d = y2d - diff_g * apz3;
y3d = apz3 + diff_g * a3d;
apz3 = a3d;
a4d = y3d - diff_g * apz4;
diffused = apz4 + diff_g * a4d;
apz4 = a4d;

// Smooth the global geometry morph internally.
target_morph = clamp(geometry_morph, 0, 1);
morph_seconds = max(morph_slew_ms, 0) * 0.001;
morph_coeff = (morph_seconds <= 0.000001) ? 1 : (1 - exp(-1 / (sr * morph_seconds)));
morph_z = morph_z + morph_coeff * (target_morph - morph_z);
morph = morph_z * morph_z * (3 - 2 * morph_z);

sa = clamp(floor(solid_a + 0.5), 0, 4);
sb = clamp(floor(solid_b + 0.5), 0, 4);

raw1 = clamp(in2, -1, 1);
raw2 = clamp(in3, -1, 1);
raw3 = clamp(in4, -1, 1);
raw4 = clamp(in5, -1, 1);
raw5 = clamp(in6, -1, 1);
raw6 = clamp(in7, -1, 1);
raw7 = clamp(in8, -1, 1);
raw8 = clamp(in9, -1, 1);

// Source-solid field.
