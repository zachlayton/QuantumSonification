// Global geometric and harmonic controls.
s = clamp(size, 0, 1);
size_scale = pow(2, (s * 4) - 2);
base_ms = 47;
gdepth = clamp(geometry_depth, 0, 1) * 0.90;
harm = clamp(harmonicity, 0, 1);
hspan = clamp(harmonic_span, 0, 1);
pdepth = clamp(pauli_depth, 0, 1) * 0.38;

rxang = rot_x * pi2;
ryang = rot_y * pi2;
rzang = rot_z * pi2;
cx = cos(rxang); sx = sin(rxang);
cy = cos(ryang); sy = sin(ryang);
cz = cos(rzang); sz = sin(rzang);

act1 = mix(aA1, aB1, morph);
amp1 = sqrt(max(act1, 0));
xg1 = mix(xA1, xB1, morph);
yg1 = mix(yA1, yB1, morph);
zg1 = mix(zA1, zB1, morph);
hl1 = mix(hA1, hB1, morph);
pv1 = mix(pA1, pB1, morph);

xr1_1 = xg1;
yr1_1 = yg1 * cx - zg1 * sx;
zr1_1 = yg1 * sx + zg1 * cx;
xr2_1 = xr1_1 * cy + zr1_1 * sy;
yr2_1 = yr1_1;
zr2_1 = -xr1_1 * sy + zr1_1 * cy;
xr1 = xr2_1 * cz - yr2_1 * sz;
yr1 = xr2_1 * sz + yr2_1 * cz;
zr1 = zr2_1;
proj1 = xr1 * 0.425325404 + yr1 * 0.601501006 + zr1 * 0.688190961;
logratio1 = (1 - harm) * (gdepth * proj1) + harm * (hspan * hl1) + pdepth * pv1;
dms1 = base_ms * size_scale * exp(logratio1);
d1 = clamp(dms1 * sr * 0.001, 16, 383999);
