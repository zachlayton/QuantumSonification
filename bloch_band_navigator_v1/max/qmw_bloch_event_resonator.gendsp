      {"box":{"id":"code","maxclass":"codebox","numinlets":1,"numoutlets":2,"outlettype":["",""],"patching_rect":[30.0,75.0,1160.0,560.0],"code":"// Bloch emergent-event modal body. Silence is the ground condition.\n// A changed eventid strikes eleven reciprocal modes; no internal metro/LFO.\nParam eventid(0); Param eventkind(0); Param eventamp(0);\nParam fidelity(1); Param participation(1); Param current(0);\nParam carrier(760); Param cellfreq(84); Param decay_ms(320); Param amp(0.34);\nParam popm5(0); Param popm4(0); Param popm3(0); Param popm2(0); Param popm1(0); Param popm0(1); Param popp1(0); Param popp2(0); Param popp3(0); Param popp4(0); Param popp5(0);\nParam phasem5(0); Param phasem4(0); Param phasem3(0); Param phasem2(0); Param phasem1(0); Param phasem0(0); Param phasep1(0); Param phasep2(0); Param phasep3(0); Param phasep4(0); Param phasep5(0);\nParam speedm5(0); Param speedm4(0); Param speedm3(0); Param speedm2(0); Param speedm1(0); Param speedm0(0); Param speedp1(0); Param speedp2(0); Param speedp3(0); Param speedp4(0); Param speedp5(0);\nHistory previous_event(0);\nHistory om5(0); History om4(0); History om3(0); History om2(0); History om1(0); History om0(0); History op1(0); History op2(0); History op3(0); History op4(0); History op5(0);\nHistory rm5(0); History rm4(0); History rm3(0); History rm2(0); History rm1(0); History rm0(0); History rp1(0); History rp2(0); History rp3(0); History rp4(0); History rp5(0);\nHistory im5(0); History im4(0); History im3(0); History im2(0); History im1(0); History im0(0); History ip1(0); History ip2(0); History ip3(0); History ip4(0); History ip5(0);\ntrigger = eventid != previous_event; previous_event = eventid;\ntwopi = 6.283185307179586;\nkindstretch = mix(1, 3, clamp(eventkind,0,1));\nbase_seconds = max(decay_ms, 12) * 0.001 * kindstretch;\ndm5=exp(-1/(base_seconds*mix(1,.48,clamp(speedm5,0,1))*samplerate)); dm4=exp(-1/(base_seconds*mix(1,.48,clamp(speedm4,0,1))*samplerate)); dm3=exp(-1/(base_seconds*mix(1,.48,clamp(speedm3,0,1))*samplerate)); dm2=exp(-1/(base_seconds*mix(1,.48,clamp(speedm2,0,1))*samplerate)); dm1=exp(-1/(base_seconds*mix(1,.48,clamp(speedm1,0,1))*samplerate)); d0=exp(-1/(base_seconds*mix(1,.48,clamp(speedm0,0,1))*samplerate)); dp1=exp(-1/(base_seconds*mix(1,.48,clamp(speedp1,0,1))*samplerate)); dp2=exp(-1/(base_seconds*mix(1,.48,clamp(speedp2,0,1))*samplerate)); dp3=exp(-1/(base_seconds*mix(1,.48,clamp(speedp3,0,1))*samplerate)); dp4=exp(-1/(base_seconds*mix(1,.48,clamp(speedp4,0,1))*samplerate)); dp5=exp(-1/(base_seconds*mix(1,.48,clamp(speedp5,0,1))*samplerate));\nsm5=trigger*eventamp*pow(max(popm5,0)+.000001,.30); sm4=trigger*eventamp*pow(max(popm4,0)+.000001,.30); sm3=trigger*eventamp*pow(max(popm3,0)+.000001,.30); sm2=trigger*eventamp*pow(max(popm2,0)+.000001,.30); sm1=trigger*eventamp*pow(max(popm1,0)+.000001,.30); s0=trigger*eventamp*pow(max(popm0,0)+.000001,.30); sp1=trigger*eventamp*pow(max(popp1,0)+.000001,.30); sp2=trigger*eventamp*pow(max(popp2,0)+.000001,.30); sp3=trigger*eventamp*pow(max(popp3,0)+.000001,.30); sp4=trigger*eventamp*pow(max(popp4,0)+.000001,.30); sp5=trigger*eventamp*pow(max(popp5,0)+.000001,.30);\nrm5=rm5*dm5+sm5*cos(phasem5); rm4=rm4*dm4+sm4*cos(phasem4); rm3=rm3*dm3+sm3*cos(phasem3); rm2=rm2*dm2+sm2*cos(phasem2); rm1=rm1*dm1+sm1*cos(phasem1); rm0=rm0*d0+s0*cos(phasem0); rp1=rp1*dp1+sp1*cos(phasep1); rp2=rp2*dp2+sp2*cos(phasep2); rp3=rp3*dp3+sp3*cos(phasep3); rp4=rp4*dp4+sp4*cos(phasep4); rp5=rp5*dp5+sp5*cos(phasep5);\nim5=im5*dm5+sm5*sin(phasem5); im4=im4*dm4+sm4*sin(phasem4); im3=im3*dm3+sm3*sin(phasem3); im2=im2*dm2+sm2*sin(phasem2); im1=im1*dm1+sm1*sin(phasem1); im0=im0*d0+s0*sin(phasem0); ip1=ip1*dp1+sp1*sin(phasep1); ip2=ip2*dp2+sp2*sin(phasep2); ip3=ip3*dp3+sp3*sin(phasep3); ip4=ip4*dp4+sp4*sin(phasep4); ip5=ip5*dp5+sp5*sin(phasep5);\nom5=fract(om5+max(20,carrier-5*cellfreq)/samplerate); om4=fract(om4+max(20,carrier-4*cellfreq)/samplerate); om3=fract(om3+max(20,carrier-3*cellfreq)/samplerate); om2=fract(om2+max(20,carrier-2*cellfreq)/samplerate); om1=fract(om1+max(20,carrier-cellfreq)/samplerate); om0=fract(om0+carrier/samplerate); op1=fract(op1+(carrier+cellfreq)/samplerate); op2=fract(op2+(carrier+2*cellfreq)/samplerate); op3=fract(op3+(carrier+3*cellfreq)/samplerate); op4=fract(op4+(carrier+4*cellfreq)/samplerate); op5=fract(op5+(carrier+5*cellfreq)/samplerate);\nreal=rm5*sin(twopi*om5)+rm4*sin(twopi*om4)+rm3*sin(twopi*om3)+rm2*sin(twopi*om2)+rm1*sin(twopi*om1)+rm0*sin(twopi*om0)+rp1*sin(twopi*op1)+rp2*sin(twopi*op2)+rp3*sin(twopi*op3)+rp4*sin(twopi*op4)+rp5*sin(twopi*op5);\nimag=im5*sin(twopi*om5)+im4*sin(twopi*om4)+im3*sin(twopi*om3)+im2*sin(twopi*om2)+im1*sin(twopi*om1)+im0*sin(twopi*om0)+ip1*sin(twopi*op1)+ip2*sin(twopi*op2)+ip3*sin(twopi*op3)+ip4*sin(twopi*op4)+ip5*sin(twopi*op5);\nlensnorm=1/sqrt(max(pow(popm5+.000001,.6)+pow(popm4+.000001,.6)+pow(popm3+.000001,.6)+pow(popm2+.000001,.6)+pow(popm1+.000001,.6)+pow(popm0+.000001,.6)+pow(popp1+.000001,.6)+pow(popp2+.000001,.6)+pow(popp3+.000001,.6)+pow(popp4+.000001,.6)+pow(popp5+.000001,.6),1));\nout1=tanh(real*.42)*amp*lensnorm; out2=tanh(imag*.42)*amp*lensnorm;\n"}},
