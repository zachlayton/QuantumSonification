      {"box":{"id":"code","maxclass":"codebox","numinlets":1,"numoutlets":4,"outlettype":["","","",""],"patching_rect":[30.0,75.0,1090.0,500.0],"code":"Param q(0);\nParam energy(1.5448614);\nParam cellfreq(92);\nParam carrier(720);\nParam energyscale(34);\nParam energyzero(1.5448614);\nParam amp(0.12);\nParam smoothms(80);\nParam cm5r(0); Param cm5i(0); Param cm4r(0); Param cm4i(0); Param cm3r(0); Param cm3i(0); Param cm2r(0); Param cm2i(0); Param cm1r(0); Param cm1i(0); Param c0r(1); Param c0i(0); Param cp1r(0); Param cp1i(0); Param cp2r(0); Param cp2i(0); Param cp3r(0); Param cp3i(0); Param cp4r(0); Param cp4i(0); Param cp5r(0); Param cp5i(0);\nHistory sq(0); History se(1.5448614);\nHistory scm5r(0); History scm5i(0); History scm4r(0); History scm4i(0); History scm3r(0); History scm3i(0); History scm2r(0); History scm2i(0); History scm1r(0); History scm1i(0); History sc0r(1); History sc0i(0); History scp1r(0); History scp1i(0); History scp2r(0); History scp2i(0); History scp3r(0); History scp3i(0); History scp4r(0); History scp4i(0); History scp5r(0); History scp5i(0);\nHistory pcell(0); History penergy(0); History pk(0);\nsm=max(smoothms,1); c=exp(-1/(sm*0.001*samplerate));\nsq=q+c*(sq-q); se=energy+c*(se-energy);\nscm5r=cm5r+c*(scm5r-cm5r); scm5i=cm5i+c*(scm5i-cm5i); scm4r=cm4r+c*(scm4r-cm4r); scm4i=cm4i+c*(scm4i-cm4i); scm3r=cm3r+c*(scm3r-cm3r); scm3i=cm3i+c*(scm3i-cm3i); scm2r=cm2r+c*(scm2r-cm2r); scm2i=cm2i+c*(scm2i-cm2i); scm1r=cm1r+c*(scm1r-cm1r); scm1i=cm1i+c*(scm1i-cm1i); sc0r=c0r+c*(sc0r-c0r); sc0i=c0i+c*(sc0i-c0i); scp1r=cp1r+c*(scp1r-cp1r); scp1i=cp1i+c*(scp1i-cp1i); scp2r=cp2r+c*(scp2r-cp2r); scp2i=cp2i+c*(scp2i-cp2i); scp3r=cp3r+c*(scp3r-cp3r); scp3i=cp3i+c*(scp3i-cp3i); scp4r=cp4r+c*(scp4r-cp4r); scp4i=cp4i+c*(scp4i-cp4i); scp5r=cp5r+c*(scp5r-cp5r); scp5i=cp5i+c*(scp5i-cp5i);\npcell=fract(pcell+cellfreq/samplerate);\npenergy=fract(penergy-max(20,carrier+energyscale*(se-energyzero))/samplerate);\npk=fract(pk+sq*cellfreq/samplerate); twopi=6.283185307179586;\nthm5=twopi*(penergy-5*pcell); thm4=twopi*(penergy-4*pcell); thm3=twopi*(penergy-3*pcell); thm2=twopi*(penergy-2*pcell); thm1=twopi*(penergy-pcell); th0=twopi*penergy; thp1=twopi*(penergy+pcell); thp2=twopi*(penergy+2*pcell); thp3=twopi*(penergy+3*pcell); thp4=twopi*(penergy+4*pcell); thp5=twopi*(penergy+5*pcell);\nu=scm5r*cos(thm5)-scm5i*sin(thm5)+scm4r*cos(thm4)-scm4i*sin(thm4)+scm3r*cos(thm3)-scm3i*sin(thm3)+scm2r*cos(thm2)-scm2i*sin(thm2)+scm1r*cos(thm1)-scm1i*sin(thm1)+sc0r*cos(th0)-sc0i*sin(th0)+scp1r*cos(thp1)-scp1i*sin(thp1)+scp2r*cos(thp2)-scp2i*sin(thp2)+scp3r*cos(thp3)-scp3i*sin(thp3)+scp4r*cos(thp4)-scp4i*sin(thp4)+scp5r*cos(thp5)-scp5i*sin(thp5);\nui=scm5r*sin(thm5)+scm5i*cos(thm5)+scm4r*sin(thm4)+scm4i*cos(thm4)+scm3r*sin(thm3)+scm3i*cos(thm3)+scm2r*sin(thm2)+scm2i*cos(thm2)+scm1r*sin(thm1)+scm1i*cos(thm1)+sc0r*sin(th0)+sc0i*cos(th0)+scp1r*sin(thp1)+scp1i*cos(thp1)+scp2r*sin(thp2)+scp2i*cos(thp2)+scp3r*sin(thp3)+scp3i*cos(thp3)+scp4r*sin(thp4)+scp4i*cos(thp4)+scp5r*sin(thp5)+scp5i*cos(thp5);\nkth=twopi*pk;\npsi=scm5r*cos(thm5+kth)-scm5i*sin(thm5+kth)+scm4r*cos(thm4+kth)-scm4i*sin(thm4+kth)+scm3r*cos(thm3+kth)-scm3i*sin(thm3+kth)+scm2r*cos(thm2+kth)-scm2i*sin(thm2+kth)+scm1r*cos(thm1+kth)-scm1i*sin(thm1+kth)+sc0r*cos(th0+kth)-sc0i*sin(th0+kth)+scp1r*cos(thp1+kth)-scp1i*sin(thp1+kth)+scp2r*cos(thp2+kth)-scp2i*sin(thp2+kth)+scp3r*cos(thp3+kth)-scp3i*sin(thp3+kth)+scp4r*cos(thp4+kth)-scp4i*sin(thp4+kth)+scp5r*cos(thp5+kth)-scp5i*sin(thp5+kth);\npsii=scm5r*sin(thm5+kth)+scm5i*cos(thm5+kth)+scm4r*sin(thm4+kth)+scm4i*cos(thm4+kth)+scm3r*sin(thm3+kth)+scm3i*cos(thm3+kth)+scm2r*sin(thm2+kth)+scm2i*cos(thm2+kth)+scm1r*sin(thm1+kth)+scm1i*cos(thm1+kth)+sc0r*sin(th0+kth)+sc0i*cos(th0+kth)+scp1r*sin(thp1+kth)+scp1i*cos(thp1+kth)+scp2r*sin(thp2+kth)+scp2i*cos(thp2+kth)+scp3r*sin(thp3+kth)+scp3i*cos(thp3+kth)+scp4r*sin(thp4+kth)+scp4i*cos(thp4+kth)+scp5r*sin(thp5+kth)+scp5i*cos(thp5+kth);\nnorm=sqrt(scm5r*scm5r+scm5i*scm5i+scm4r*scm4r+scm4i*scm4i+scm3r*scm3r+scm3i*scm3i+scm2r*scm2r+scm2i*scm2i+scm1r*scm1r+scm1i*scm1i+sc0r*sc0r+sc0i*sc0i+scp1r*scp1r+scp1i*scp1i+scp2r*scp2r+scp2i*scp2i+scp3r*scp3r+scp3i*scp3i+scp4r*scp4r+scp4i*scp4i+scp5r*scp5r+scp5i*scp5i); invnorm=1/max(norm,0.0001);\nout1=tanh(u*invnorm*0.55)*amp; out2=tanh(ui*invnorm*0.55)*amp; out3=tanh(psi*invnorm*0.55)*amp; out4=tanh(psii*invnorm*0.55)*amp;\n"}},
