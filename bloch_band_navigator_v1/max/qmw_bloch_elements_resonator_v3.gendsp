      {"box":{"id":"code","maxclass":"codebox","numinlets":1,"numoutlets":2,"outlettype":["",""],"patching_rect":[30.0,75.0,1090.0,530.0],"code":"// QMW Elements-inspired signal-struck modal body v3.\n// in1 is a one-sample impulse created only by a simulation event.\nParam eventid(0); Param eventkind(0); Param eventamp(1); Param fidelity(1); Param participation(1); Param current(0);\nParam fundamental(92); Param geometry(.42); Param brightness(.68); Param damping(.72); Param position(.37); Param state_geometry(.35); Param quantum_color(.78); Param strike_ms(2.8); Param amp(.72);\nParam popm5(0); Param popm4(0); Param popm3(0); Param popm2(0); Param popm1(0); Param popm0(1); Param popp1(0); Param popp2(0); Param popp3(0); Param popp4(0); Param popp5(0);\nParam phasem5(0); Param phasem4(0); Param phasem3(0); Param phasem2(0); Param phasem1(0); Param phasem0(0); Param phasep1(0); Param phasep2(0); Param phasep3(0); Param phasep4(0); Param phasep5(0);\nParam speedm5(0); Param speedm4(0); Param speedm3(0); Param speedm2(0); Param speedm1(0); Param speedm0(0); Param speedp1(0); Param speedp2(0); Param speedp3(0); Param speedp4(0); Param speedp5(0);\nHistory ph0(0); History ph1(0); History ph2(0); History ph3(0); History ph4(0); History ph5(0); History ph6(0); History ph7(0);\nHistory en0(0); History en1(0); History en2(0); History en3(0); History en4(0); History en5(0); History en6(0); History en7(0);\nstrike=abs(in1)*clamp(eventamp,.15,1.5); kind=clamp(eventkind,0,1); part=clamp((participation-1)/5,0,1); geom=clamp(geometry+state_geometry*(.28*(part-.5)+.12*current),0,1); bright=clamp(brightness+.14*(1-fidelity),.05,1); ring=clamp(damping+.12*(1-fidelity)+.08*kind,.05,.99); pos=clamp(position+.22*current,.01,.99); color=clamp(quantum_color,0,1);\nbase=max(fundamental,24); stiff=.045*pow(geom,3); decay=.06+2.6*pow(ring,2.4); twopi=6.283185307179586; pi=3.141592653589793;\nf0=clamp(base*sqrt(1+stiff),20,samplerate*.45); f1=clamp(base*2*sqrt(1+stiff*4),20,samplerate*.45); f2=clamp(base*3*sqrt(1+stiff*9),20,samplerate*.45); f3=clamp(base*4*sqrt(1+stiff*16),20,samplerate*.45); f4=clamp(base*5*sqrt(1+stiff*25),20,samplerate*.45); f5=clamp(base*6*sqrt(1+stiff*36),20,samplerate*.45); f6=clamp(base*7*sqrt(1+stiff*49),20,samplerate*.45); f7=clamp(base*8*sqrt(1+stiff*64),20,samplerate*.45);\nd0=exp(-1/max(decay*samplerate,1)); d1=exp(-(1+.18*(1-bright))/max(decay*samplerate,1)); d2=exp(-(1+.42*(1-bright))/max(decay*samplerate,1)); d3=exp(-(1+.75*(1-bright))/max(decay*samplerate,1)); d4=exp(-(1+1.2*(1-bright))/max(decay*samplerate,1)); d5=exp(-(1+1.8*(1-bright))/max(decay*samplerate,1)); d6=exp(-(1+2.7*(1-bright))/max(decay*samplerate,1)); d7=exp(-(1+4*(1-bright))/max(decay*samplerate,1));\nw0=pow(max(popm5,.000001),.28); w1=pow(max(popm4,.000001),.28)*pow(bright,.12); w2=pow(max(popm3,.000001),.28)*pow(bright,.24); w3=pow(max(popm2,.000001),.28)*pow(bright,.36); w4=pow(max(popm1,.000001),.28)*pow(bright,.48); w5=pow(max(popm0,.000001),.28)*pow(bright,.60); w6=pow(max(popp1,.000001),.28)*pow(bright,.74); w7=pow(max(popp2,.000001),.28)*pow(bright,.90);\nen0=en0*d0+strike*w0; en1=en1*d1+strike*w1; en2=en2*d2+strike*w2; en3=en3*d3+strike*w3; en4=en4*d4+strike*w4; en5=en5*d5+strike*w5; en6=en6*d6+strike*w6; en7=en7*d7+strike*w7;\nph0=fract(ph0+f0/samplerate); ph1=fract(ph1+f1/samplerate); ph2=fract(ph2+f2/samplerate); ph3=fract(ph3+f3/samplerate); ph4=fract(ph4+f4/samplerate); ph5=fract(ph5+f5/samplerate); ph6=fract(ph6+f6/samplerate); ph7=fract(ph7+f7/samplerate);\na0=twopi*ph0+color*phasem5; a1=twopi*ph1+color*phasem4; a2=twopi*ph2+color*phasem3; a3=twopi*ph3+color*phasem2; a4=twopi*ph4+color*phasem1; a5=twopi*ph5+color*phasem0; a6=twopi*ph6+color*phasep1; a7=twopi*ph7+color*phasep2;\nr0=cos(pi*pos); r1=cos(pi*pos*2); r2=cos(pi*pos*3); r3=cos(pi*pos*4); r4=cos(pi*pos*5); r5=cos(pi*pos*6); r6=cos(pi*pos*7); r7=cos(pi*pos*8);\ni0=sin(pi*pos); i1=sin(pi*pos*2); i2=sin(pi*pos*3); i3=sin(pi*pos*4); i4=sin(pi*pos*5); i5=sin(pi*pos*6); i6=sin(pi*pos*7); i7=sin(pi*pos*8);\nreal=en0*sin(a0)*r0+en1*sin(a1)*r1+en2*sin(a2)*r2+en3*sin(a3)*r3+en4*sin(a4)*r4+en5*sin(a5)*r5+en6*sin(a6)*r6+en7*sin(a7)*r7;\nimag=en0*cos(a0)*i0+en1*cos(a1)*i1+en2*cos(a2)*i2+en3*cos(a3)*i3+en4*cos(a4)*i4+en5*cos(a5)*i5+en6*cos(a6)*i6+en7*cos(a7)*i7;\nout1=tanh(real*.55)*amp; out2=tanh(imag*.55)*amp;\n"}},
