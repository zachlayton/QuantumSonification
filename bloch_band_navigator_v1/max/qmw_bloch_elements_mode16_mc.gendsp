    "boxes": [
      {"box":{"id":"in","maxclass":"newobj","numinlets":0,"numoutlets":1,"outlettype":[""],"patching_rect":[30.0,30.0,35.0,22.0],"text":"in 1"}},
      {"box":{"id":"code","maxclass":"codebox","numinlets":1,"numoutlets":2,"outlettype":["",""],"patching_rect":[30.0,75.0,1140.0,570.0],"code":"// QMW Bloch / Elements-inspired modal event body.\n// Modal-spacing, loss, and pickup ideas adapted from Mutable Instruments\n// Elements resonator by Emilie Gillet (2014), MIT license. No source LFO.\n// See THIRD_PARTY_ELEMENTS_NOTICE.md.\nParam eventid(0); Param eventkind(0); Param eventamp(0);\nParam fidelity(1); Param participation(1); Param current(0);\nParam fundamental(92); Param geometry(.42); Param brightness(.68); Param damping(.72); Param position(.37);\nParam state_geometry(.35); Param quantum_color(.78); Param strike_ms(2.8); Param amp(.72);\nParam popm5(0); Param popm4(0); Param popm3(0); Param popm2(0); Param popm1(0); Param popm0(1); Param popp1(0); Param popp2(0); Param popp3(0); Param popp4(0); Param popp5(0);\nParam phasem5(0); Param phasem4(0); Param phasem3(0); Param phasem2(0); Param phasem1(0); Param phasem0(0); Param phasep1(0); Param phasep2(0); Param phasep3(0); Param phasep4(0); Param phasep5(0);\nParam speedm5(0); Param speedm4(0); Param speedm3(0); Param speedm2(0); Param speedm1(0); Param speedm0(0); Param speedp1(0); Param speedp2(0); Param speedp3(0); Param speedp4(0); Param speedp5(0);\nHistory previous_event(0); History exciter_envelope(0); History ic1eq(0); History ic2eq(0);\nlane=clamp(mc_channel-1,0,15);\ntrigger=eventid!=previous_event; previous_event=eventid;\nkind=clamp(eventkind,0,1); event_strength=clamp(eventamp,0,1.5);\nstrike_seconds=max(strike_ms,0.2)*.001*mix(1,3.2,kind);\nstrike_decay=exp(-1/max(strike_seconds*samplerate,1));\nexciter_envelope=max(trigger*event_strength,exciter_envelope*strike_decay);\npartnorm=clamp((participation-1)/5,0,1);\ngeom=clamp(geometry+state_geometry*(.30*(partnorm-.5)+.14*current),0,1);\nbright=clamp(brightness*(.62+.38*partnorm)+.12*(1-fidelity),0,1);\nresonance=clamp(damping+.18*(1-fidelity)+.08*kind,0,1);\npos=clamp(position+.24*current,.001,.999);\nstiffness=0;\nif(geom<.25){stiffness=-(.25-geom)*.25;}\nelse if(geom<.30){stiffness=0;}\nelse if(geom<.90){gg=(geom-.30)/.60; stiffness=.01*pow(10,gg*2.005)-.01;}\nelse{gg=(geom-.90)/.10; gg=gg*gg; stiffness=1.5-.5*cos(gg*3.141592653589793);}\nstiffness_decay=(stiffness<0)*.93+(stiffness>=0)*.98;\nstretch=1+stiffness*(1-pow(stiffness_decay,lane))/max(1-stiffness_decay,.0001);\nmode_frequency=clamp(max(fundamental,20)*(lane+1)*max(stretch,.05),20,samplerate*.44);\nlane_pop=(lane==0)*popm5+(lane==1)*popm4+(lane==2)*popm3+(lane==3)*popm2+(lane==4)*popm1+(lane==5)*popm0+(lane==6)*popp1+(lane==7)*popp2+(lane==8)*popp3+(lane==9)*popp4+(lane==10)*popp5+(lane>10)*max((1-fidelity)*.035/(lane-9),.000001);\nlane_phase=(lane==0)*phasem5+(lane==1)*phasem4+(lane==2)*phasem3+(lane==3)*phasem2+(lane==4)*phasem1+(lane==5)*phasem0+(lane==6)*phasep1+(lane==7)*phasep2+(lane==8)*phasep3+(lane==9)*phasep4+(lane==10)*phasep5+(lane>10)*current*3.141592653589793*(lane+1);\nlane_speed=(lane==0)*speedm5+(lane==1)*speedm4+(lane==2)*speedm3+(lane==3)*speedm2+(lane==4)*speedm1+(lane==5)*speedm0+(lane==6)*speedp1+(lane==7)*speedp2+(lane==8)*speedp3+(lane==9)*speedp4+(lane==10)*speedp5+(lane>10)*(1-fidelity);\nq_loss=bright*(2-bright)*.85+.15;\nq_loss_rate=geom*(2-geom)*.1;\nloss_at_lane=1-(1-q_loss)*pow(max(1-q_loss_rate,.001),lane);\nbase_q=2+86*pow(resonance,2.35);\nmode_q=clamp(base_q*pow(max(loss_at_lane,.08),lane*.34)*mix(1,.58,clamp(lane_speed,0,1)),1.4,90);\nquantum_weight=mix(1,pow(max(lane_pop*11,.000001),.30),clamp(quantum_color,0,1));\nhigh_loss=pow(max(loss_at_lane,.08),lane*.20);\nmallet=noise()*exciter_envelope*quantum_weight*high_loss;\ng=tan(3.141592653589793*mode_frequency/samplerate); k=1/mode_q; a1=1/(1+g*(g+k)); a2=g*a1; a3=g*a2;\nv3=mallet-ic2eq; v1=a1*ic1eq+a2*v3; v2=ic2eq+a2*ic1eq+a3*v3; ic1eq=2*v1-ic1eq; ic2eq=2*v2-ic2eq;\nband=v1*sqrt(mode_q*.055);\npickup_center=cos(3.141592653589793*pos*(lane+1)); pickup_side=sin(3.141592653589793*pos*(lane+1));\ncomplex_mix=clamp(quantum_color,0,1);\nreal_weight=mix(pickup_center,cos(lane_phase),complex_mix); imag_weight=mix(pickup_side,sin(lane_phase),complex_mix);\nout1=tanh(band*real_weight*.75)*amp; out2=tanh(band*imag_weight*.75)*amp;\n"}},
      {"box":{"id":"out1","maxclass":"newobj","numinlets":1,"numoutlets":0,"patching_rect":[30.0,680.0,45.0,22.0],"text":"out 1"}},
