      { "box": { "id": "obj-54", "maxclass": "message", "text": "identity", "patching_rect": [1460.0, 345.0, 53.0, 22.0] } },

      { "box": { "id": "obj-55", "maxclass": "newobj", "text": "prepend autocommit", "numinlets": 1, "numoutlets": 1, "outlettype": [""], "patching_rect": [1110.0, 430.0, 125.0, 22.0] } },
      { "box": { "id": "obj-56", "maxclass": "newobj", "text": "prepend threshold", "numinlets": 1, "numoutlets": 1, "outlettype": [""], "patching_rect": [1245.0, 430.0, 115.0, 22.0] } },
