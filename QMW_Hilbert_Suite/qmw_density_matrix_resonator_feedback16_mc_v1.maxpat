    "description": "Safe complex density-matrix coupling inside a sixteen-channel resonator feedback field.",
    "digest": "Projects rho acting on analytic audio through per-branch phase, delay, and bounded feedback gain.",
    "tags": "MC hilbert density matrix resonator complex feedback quantum",
    "boxes": [
      { "box": { "id": "obj-1", "maxclass": "comment", "fontsize": 22.0, "fontface": 1, "text": "QMW Density-Matrix Resonator Feedback — 16 MC v1", "patching_rect": [30.0, 18.0, 690.0, 31.0] } },
      { "box": { "id": "obj-2", "maxclass": "comment", "fontsize": 13.0, "text": "state = raw + feedback;  feedback = g D_tau[cos(theta) Re(rho z) - sin(theta) Im(rho z)]", "patching_rect": [31.0, 52.0, 900.0, 21.0] } },

      { "box": { "id": "obj-3", "maxclass": "inlet", "index": 1, "comment": "16-channel raw resonator source", "numinlets": 0, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [50.0, 110.0, 30.0, 30.0] } },
      { "box": { "id": "obj-4", "maxclass": "inlet", "index": 2, "comment": "Re(rho), 256 row-major floats", "numinlets": 0, "numoutlets": 1, "outlettype": [""], "patching_rect": [330.0, 110.0, 30.0, 30.0] } },
      { "box": { "id": "obj-5", "maxclass": "inlet", "index": 3, "comment": "Im(rho), 256 row-major floats", "numinlets": 0, "numoutlets": 1, "outlettype": [""], "patching_rect": [485.0, 110.0, 30.0, 30.0] } },
      { "box": { "id": "obj-6", "maxclass": "inlet", "index": 4, "comment": "16 projection phases in radians", "numinlets": 0, "numoutlets": 1, "outlettype": [""], "patching_rect": [645.0, 110.0, 30.0, 30.0] } },
      { "box": { "id": "obj-7", "maxclass": "inlet", "index": 5, "comment": "16 feedback gains", "numinlets": 0, "numoutlets": 1, "outlettype": [""], "patching_rect": [800.0, 110.0, 30.0, 30.0] } },
      { "box": { "id": "obj-8", "maxclass": "inlet", "index": 6, "comment": "16 delay times in milliseconds", "numinlets": 0, "numoutlets": 1, "outlettype": [""], "patching_rect": [950.0, 110.0, 30.0, 30.0] } },
      { "box": { "id": "obj-9", "maxclass": "inlet", "index": 7, "comment": "control messages", "numinlets": 0, "numoutlets": 1, "outlettype": [""], "patching_rect": [1120.0, 110.0, 30.0, 30.0] } },

      { "box": { "id": "obj-10", "maxclass": "comment", "fontface": 1, "text": "raw MC", "patching_rect": [40.0, 84.0, 70.0, 20.0] } },
      { "box": { "id": "obj-11", "maxclass": "comment", "text": "Re(rho)", "patching_rect": [315.0, 84.0, 70.0, 20.0] } },
      { "box": { "id": "obj-12", "maxclass": "comment", "text": "Im(rho)", "patching_rect": [470.0, 84.0, 70.0, 20.0] } },
      { "box": { "id": "obj-13", "maxclass": "comment", "text": "phase[16]", "patching_rect": [625.0, 84.0, 80.0, 20.0] } },
      { "box": { "id": "obj-14", "maxclass": "comment", "text": "gain[16]", "patching_rect": [785.0, 84.0, 75.0, 20.0] } },
      { "box": { "id": "obj-15", "maxclass": "comment", "text": "delay ms[16]", "patching_rect": [925.0, 84.0, 95.0, 20.0] } },
      { "box": { "id": "obj-16", "maxclass": "comment", "text": "mode / safety / matrix control", "patching_rect": [1050.0, 84.0, 185.0, 20.0] } },

      { "box": { "id": "obj-17", "maxclass": "newobj", "text": "mc.+~", "numinlets": 2, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [90.0, 250.0, 52.0, 22.0] } },
      { "box": { "id": "obj-18", "maxclass": "comment", "fontface": 1, "text": "recursive state (16ch)", "patching_rect": [90.0, 224.0, 150.0, 20.0] } },
      { "box": { "id": "obj-19", "maxclass": "newobj", "text": "qmw_density_matrix_hilbert_operator16_mc_v1", "numinlets": 4, "numoutlets": 4, "outlettype": ["multichannelsignal", "multichannelsignal", "multichannelsignal", ""], "patching_rect": [90.0, 315.0, 315.0, 22.0] } },
      { "box": { "id": "obj-20", "maxclass": "comment", "text": "The nested operator computes y = rho(I+iQ); its audition outlet is not used in the loop.", "patching_rect": [90.0, 343.0, 535.0, 20.0] } },

      { "box": { "id": "obj-21", "maxclass": "newobj", "text": "js qmw_feedback_branch_controls16_v1.js", "numinlets": 3, "numoutlets": 4, "outlettype": ["", "", "", ""], "patching_rect": [645.0, 185.0, 260.0, 22.0] } },
      { "box": { "id": "obj-22", "maxclass": "newobj", "text": "mcs.sig~ 0. @chans 16", "numinlets": 1, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [645.0, 250.0, 150.0, 22.0] } },
      { "box": { "id": "obj-23", "maxclass": "newobj", "text": "mc.rampsmooth~ 960 960", "numinlets": 3, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [645.0, 285.0, 160.0, 22.0] } },
      { "box": { "id": "obj-24", "maxclass": "newobj", "text": "mc.cosx~", "numinlets": 1, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [570.0, 385.0, 68.0, 22.0] } },
      { "box": { "id": "obj-25", "maxclass": "newobj", "text": "mc.sinx~", "numinlets": 1, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [690.0, 385.0, 68.0, 22.0] } },
      { "box": { "id": "obj-26", "maxclass": "newobj", "text": "mc.*~", "numinlets": 2, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [315.0, 430.0, 52.0, 22.0] } },
      { "box": { "id": "obj-27", "maxclass": "newobj", "text": "mc.*~", "numinlets": 2, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [475.0, 430.0, 52.0, 22.0] } },
      { "box": { "id": "obj-28", "maxclass": "newobj", "text": "mc.-~", "numinlets": 2, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [390.0, 485.0, 52.0, 22.0] } },
      { "box": { "id": "obj-29", "maxclass": "comment", "fontface": 1, "text": "phase projection: cos(theta)y_re - sin(theta)y_im", "patching_rect": [315.0, 515.0, 330.0, 20.0] } },

      { "box": { "id": "obj-30", "maxclass": "newobj", "text": "mc.tapin~ 2000.", "numinlets": 1, "numoutlets": 1, "outlettype": ["tapconnect"], "patching_rect": [390.0, 560.0, 112.0, 22.0] } },
      { "box": { "id": "obj-31", "maxclass": "newobj", "text": "mc.tapout~ 10.", "numinlets": 1, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [390.0, 615.0, 105.0, 22.0] } },
      { "box": { "id": "obj-32", "maxclass": "comment", "text": "explicit causal memory; continuous per-channel delay input", "patching_rect": [510.0, 588.0, 340.0, 20.0] } },
      { "box": { "id": "obj-33", "maxclass": "newobj", "text": "mcs.sig~ 10. @chans 16", "numinlets": 1, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [930.0, 250.0, 160.0, 22.0] } },
      { "box": { "id": "obj-34", "maxclass": "newobj", "text": "mc.rampsmooth~ 960 960", "numinlets": 3, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [930.0, 285.0, 160.0, 22.0] } },

      { "box": { "id": "obj-35", "maxclass": "newobj", "text": "mcs.sig~ 0. @chans 16", "numinlets": 1, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [800.0, 345.0, 150.0, 22.0] } },
      { "box": { "id": "obj-36", "maxclass": "newobj", "text": "mc.rampsmooth~ 960 960", "numinlets": 3, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [800.0, 385.0, 160.0, 22.0] } },
      { "box": { "id": "obj-37", "maxclass": "newobj", "text": "mc.sig~ 0. @chans 16", "numinlets": 1, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [1010.0, 385.0, 145.0, 22.0] } },
      { "box": { "id": "obj-38", "maxclass": "newobj", "text": "mc.*~", "numinlets": 2, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [800.0, 445.0, 52.0, 22.0] } },
      { "box": { "id": "obj-39", "maxclass": "newobj", "text": "mc.*~", "numinlets": 2, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [590.0, 675.0, 52.0, 22.0] } },
      { "box": { "id": "obj-40", "maxclass": "comment", "text": "bounded gain × hard mode gate", "patching_rect": [655.0, 676.0, 190.0, 20.0] } },

      { "box": { "id": "obj-41", "maxclass": "newobj", "text": "route mode panic safe identity clear commit autocommit threshold ramp ceiling delayrange tune status hilbertclear", "numinlets": 1, "numoutlets": 15, "outlettype": ["", "", "", "", "", "", "", "", "", "", "", "", "", "", ""], "patching_rect": [1040.0, 185.0, 480.0, 22.0] } },
      { "box": { "id": "obj-42", "maxclass": "newobj", "text": "clip 1 2", "numinlets": 3, "numoutlets": 1, "outlettype": ["int"], "patching_rect": [1120.0, 250.0, 60.0, 22.0] } },
      { "box": { "id": "obj-43", "maxclass": "newobj", "text": "t i i", "numinlets": 1, "numoutlets": 2, "outlettype": ["int", "int"], "patching_rect": [1120.0, 285.0, 42.0, 22.0] } },
      { "box": { "id": "obj-44", "maxclass": "newobj", "text": "== 2", "numinlets": 2, "numoutlets": 1, "outlettype": ["int"], "patching_rect": [1030.0, 345.0, 42.0, 22.0] } },
      { "box": { "id": "obj-45", "maxclass": "newobj", "text": "mc.selector~ 2", "numinlets": 3, "numoutlets": 1, "outlettype": ["multichannelsignal"], "patching_rect": [90.0, 755.0, 95.0, 22.0] } },
      { "box": { "id": "obj-46", "maxclass": "comment", "text": "mode 1 = exact RAW and loop gate closed; mode 2 = recursive state", "patching_rect": [195.0, 756.0, 390.0, 20.0] } },

      { "box": { "id": "obj-47", "maxclass": "message", "text": "zero", "patching_rect": [1190.0, 345.0, 38.0, 22.0] } },
