      { "box": { "id": "obj-50", "maxclass": "message", "text": "hilbertclear", "patching_rect": [1330.0, 345.0, 75.0, 22.0] } },
      { "box": { "id": "obj-51", "maxclass": "newobj", "text": "t b b b b", "numinlets": 1, "numoutlets": 4, "outlettype": ["bang", "bang", "bang", "bang"], "patching_rect": [1190.0, 310.0, 75.0, 22.0] } },
      { "box": { "id": "obj-52", "maxclass": "newobj", "text": "t b b b b b", "numinlets": 1, "numoutlets": 5, "outlettype": ["bang", "bang", "bang", "bang", "bang"], "patching_rect": [1280.0, 310.0, 90.0, 22.0] } },
