      {
        "box": {
          "id": "code",
          "maxclass": "codebox",
          "patching_rect": [
            30,
            85,
            1080,
            545
          ],
          "numinlets": 5,
          "numoutlets": 3,
          "outlettype": [
            "",
            "",
            ""
          ],
          "code": "// QMW Analytic Phase Projector 16 MC v1\n//\n// in1/in2: pre-matrix analytic I/Q rails\n// in3/in4: post-matrix complex real/imaginary rails\n// in5: conductor phase, one value per MC lane (radians)\n//\n// out1: analytic rotation before rho\n// out2: analytic rotation after rho\n// out3: matrix-only delta (post - pre)\n//\n// This is deliberately a direct audition path.  The earlier feedback engine\n// only exposed phase inside a low-gain recursive return, which made correct\n// Hilbert processing difficult to hear.  Here phase can rotate every\n// harmonic, spread across harmonic number, and move continuously as a\n// single-sideband shift while remaining sample-synchronous for pre/post A/B.\n\nParam hilbert_depth(1);\nParam phase_depth(1);\nParam phase_spread(0);\nParam phase_bias(0);\nParam ssb_hz(0);\nParam delta_gain(1);\n\nHistory shift_phase(0);\n\nlane = clamp(mc_channel - 1, 0, 15);\ncentered_lane = lane - 7.5;\n\nshift_phase = shift_phase + ssb_hz / samplerate;\nshift_phase = shift_phase - floor(shift_phase);\n\ntheta = phase_bias\n    + in5 * phase_depth\n    + centered_lane * phase_spread\n    + 6.283185307179586 * shift_phase;\n\nc = cos(theta);\ns = sin(theta);\n\npre_rotated = in1 * c - in2 * s;\npost_rotated = in3 * c - in4 * s;\n\ndepth = clamp(hilbert_depth, 0, 1);\npre_audition = mix(in1, pre_rotated, depth);\npost_audition = mix(in3, post_rotated, depth);\n\nout1 = pre_audition;\nout2 = post_audition;\nout3 = (post_audition - pre_audition) * clamp(delta_gain, 0, 8);\n"
        }
      },
